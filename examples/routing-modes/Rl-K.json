{
  "endpoints": [
    {
      "id": "rayline-cloud",
      "protocol": "anthropic_messages",
      "base_url": "https://api.rayline.ai",
      "api_key_env": "RAYLINE_ROUTER_API_KEY",
      "auth": "api_key",
      "models": [
        "arc-sage-1.0",
        "arc-swift-1.0",
        "glm-5.3"
      ]
    },
    {
      "id": "anthropic",
      "protocol": "anthropic_messages",
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY",
      "auth": "api_key",
      "models": [
        "claude-sonnet-5"
      ]
    }
  ],
  "routes": {
    "main": {
      "endpoint": "rayline-cloud",
      "model": "glm-5.3",
      "router": "rayline-local"
    },
    "subagent": {
      "endpoint": "anthropic",
      "model": "claude-sonnet-5"
    }
  }
}
