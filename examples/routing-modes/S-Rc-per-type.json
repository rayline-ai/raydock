{
  "endpoints": [
    {
      "id": "rayline-cloud",
      "protocol": "anthropic_messages",
      "base_url": "https://api.rayline.ai",
      "api_key_env": "RAYLINE_ROUTER_API_KEY",
      "auth": "api_key",
      "models": [
        "arc-sage-1.0",
        "arc-swift-1.0"
      ]
    }
  ],
  "routes": {
    "main": {
      "endpoint": "subscription"
    },
    "subagents": {
      "Explore": {
        "endpoint": "rayline-cloud",
        "model": "arc-swift-1.0"
      }
    }
  }
}
