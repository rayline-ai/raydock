class Raydock < Formula
  desc "Raydock on-device CLI for local models and cloud services"
  homepage "https://rayline.ai"
  license "Apache-2.0"
  version "__VERSION__"

  on_macos do
    on_arm do
      url "__RELEASE_BASE_URL__/rayline-__VERSION__-macosx_11_0_arm64.tar.gz"
      sha256 "__MACOS_ARM64_SHA256__"
    end

    on_intel do
      url "__RELEASE_BASE_URL__/rayline-__VERSION__-macosx_10_12_x86_64.tar.gz"
      sha256 "__MACOS_X86_64_SHA256__"
    end
  end

  on_linux do
    on_arm do
      url "__RELEASE_BASE_URL__/rayline-__VERSION__-linux_aarch64.tar.gz"
      sha256 "__LINUX_AARCH64_SHA256__"
    end

    on_intel do
      url "__RELEASE_BASE_URL__/rayline-__VERSION__-linux_x86_64.tar.gz"
      sha256 "__LINUX_X86_64_SHA256__"
    end
  end

  def install
    archive_root = Dir["rayline-*"].find { |path| File.directory?(path) }
    if archive_root
      bin.install "#{archive_root}/raydock"
      bin.install "#{archive_root}/rld"
      bin.install "#{archive_root}/rayline-core"
      pkgshare.install "#{archive_root}/rayline-core-LICENSE"
      pkgshare.install "#{archive_root}/NOTICE"
    else
      bin.install "raydock"
      bin.install "rld"
      bin.install "rayline-core"
      pkgshare.install "rayline-core-LICENSE"
    end
    bin.install_symlink "raydock" => "rayline"
  end

  test do
    assert_match "raydock #{version}", shell_output("#{bin}/raydock --version")
    assert_path_exists bin/"rayline-core"
    assert_path_exists pkgshare/"rayline-core-LICENSE"
  end
end
